# Used by the root-level npm commands (npm start and npm run seed).
# Keep this pointed at a disposable local development database.
MONGODB_URI=mongodb://127.0.0.1:27017/BlogPlatform_local?directConnection=true&serverSelectionTimeoutMS=2000
PORT=8080
JWT_SECRET=replace-with-a-long-random-production-secret
CORS_ORIGINS=http://localhost:8000
BACKUP_DIR=./backups/mongodb
RETENTION_DAYS=14
INCLUDE_OPLOG=NO
REMOTE_BACKUP=NO
S3_BUCKET=your-private-backup-bucket
S3_PREFIX=blog-platform/mongodb
AWS_REGION=your-aws-region
AWS_KMS_KEY_ID=your-kms-key-id
