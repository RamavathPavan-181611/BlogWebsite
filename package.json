{
  "name": "blog-platform-mern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backend": "cd backend && DOTENV_CONFIG_PATH=../.env npm start",
    "frontend": "cd frontend && npm start",
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "seed": "cd backend && DOTENV_CONFIG_PATH=../.env npm run seed",
    "backup": "./scripts/backup-mongodb.sh",
    "restore": "./scripts/restore-mongodb.sh",
    "test": "cd backend && npm run test"
  },
  "dependencies": {
    "concurrently": "7.6.0"
  }
}
