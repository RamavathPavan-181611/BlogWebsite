# Used when running commands directly from the backend directory.
# Keep this pointed at a disposable local development database.
MONGODB_URI=mongodb://127.0.0.1:27017/BlogPlatform_local?directConnection=true&serverSelectionTimeoutMS=2000
PORT=8080
JWT_SECRET=replace-with-a-long-random-production-secret
CORS_ORIGINS=http://localhost:8000
